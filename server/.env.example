# Copiază acest fișier ca `.env` (în același folder) și completează ce ai nevoie.
# Fișierul .env NU se urcă pe GitHub.

# Server
PORT=3000
# NODE_ENV=production   # activează HTTPS strict (HSTS) și cookie-uri Secure
# TRUST_PROXY=true      # pune true dacă serverul stă în spatele unui proxy (Cloudflare, Nginx, Render)

# Site-urile care pot trimite formularul și statisticile către acest backend
ALLOWED_ORIGINS=http://localhost:3000,https://afyze.github.io,https://afyze.com,https://www.afyze.com

# Notificări pe e-mail la fiecare cerere nouă (opțional)
# Exemplu Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=adresa ta, SMTP_PASS=o „parolă de aplicație”
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=hello@afyze.com
